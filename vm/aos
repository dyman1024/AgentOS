#!/usr/bin/env python3
"""Forward an explicit host request using the current command's short-lived token."""
import json,os,socket,sys
if len(sys.argv)<2:sys.exit('Usage: aos method [JSON arguments]')
s=socket.socket(socket.AF_VSOCK,socket.SOCK_STREAM);s.settimeout(120);s.connect((2,5202))
s.sendall(json.dumps({'token':os.environ.get('AOS_RUN_TOKEN',''),'method':sys.argv[1],'args':json.loads(sys.argv[2]) if len(sys.argv)>2 else {}}).encode()+b'\n')
data=bytearray()
while b'\n' not in data:
    part=s.recv(65536)
    if not part:break
    data.extend(part)
    if len(data)>8_000_000:sys.exit('Response exceeds limit')
print(data.decode())
