// Signing defaults to ad-hoc ("-"), which works on this Mac without an Apple account.
// To sign with your own certificate (keeps Keychain access stable across rebuilds), create
// Config/Local.xcconfig (git-ignored) with e.g.:
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team id>
//   CODE_SIGN_STYLE = Automatic
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
